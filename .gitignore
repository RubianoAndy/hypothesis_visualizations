# Git ignore para proyecto LaTeX
# Ignorar archivos intermedios generados por LaTeX
*.aux
*.bbl
*.blg
*.brf
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.nav
*.snm
*.vrb
*.idx
*.ilg
*.ind
*.run.xml
*.auxlock

# Ignorar archivos y carpetas de construcción
/build/

# Configs y caches de herramientas
.latexmkrc

# Archivos temporales y backups de editores / OS
*~
*.swp
*.swo
.#*
*.bak
*.tmp
*.out.*
.DS_Store
Thumbs.db

# IDE/editors
.vscode/
.idea/

# Binarios y objetos (para carpeta utils/codes)
*.o
*.exe
*.out
*.class
*.so
*.dll

# Opcional: si quieres ignorar PDFs generados, descomenta la siguiente línea
# *.pdf
